@prefix wa: <https://data.example.com/wiper-arm/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wa:product-specification/wiper-arm-A
    a wa:ProductSpecification ;
    wa:name "Wiper arm type A" .

wa:sap-material-code/10001234
    a wa:ERPProductCode ;
    wa:erpCode "10001234" ;
    wa:identifiesSpecification
        wa:product-specification/wiper-arm-A .

wa:batch/input-batch-001
    a wa:ProductionBatch ;
    wa:batchIdentifier "INPUT-BATCH-001" .

wa:spool/input-spool-001
    a wa:Spool ;
    wa:spoolIdentifier "INPUT-SPOOL-001" ;
    wa:partOfBatch wa:batch/input-batch-001 ;
    wa:consumedBy wa:execution/rolling-9001 .

wa:process/rolling
    a wa:ManufacturingProcess ;
    wa:name "Rolling" .

wa:equipment/rolling-line-03
    a wa:Equipment ;
    wa:name "Rolling line 03" .

wa:site/plant-A
    a wa:ProductionSite ;
    wa:name "Plant A" .

wa:execution/rolling-9001
    a wa:ProcessExecution ;
    wa:executionIdentifier "ROLLING-9001" ;
    wa:realizesProcess wa:process/rolling ;
    wa:performedOn wa:equipment/rolling-line-03 ;
    wa:occurredAt wa:site/plant-A ;
    wa:startTime
        "2026-10-20T08:13:00"^^xsd:dateTime ;
    wa:endTime
        "2026-10-20T09:47:00"^^xsd:dateTime ;
    wa:producesSpool
        wa:spool/output-spool-101,
        wa:spool/output-spool-102 .

wa:batch/output-batch-010
    a wa:ProductionBatch ;
    wa:batchIdentifier "OUTPUT-BATCH-010" ;
    wa:classifiedBy
        wa:product-specification/wiper-arm-A .

wa:spool/output-spool-101
    a wa:Spool ;
    wa:spoolIdentifier "OUTPUT-SPOOL-101" ;
    wa:partOfBatch wa:batch/output-batch-010 .

wa:spool/output-spool-102
    a wa:Spool ;
    wa:spoolIdentifier "OUTPUT-SPOOL-102" ;
    wa:partOfBatch wa:batch/output-batch-010 .