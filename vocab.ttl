@prefix wa: <https://data.example.com/wiper-arm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wa:TraceabilityOntology
    a owl:Ontology ;
    rdfs:label "Wiper Arm Traceability Ontology" .

#################################################################
# Classes
#################################################################

wa:ProductSpecification
    a owl:Class ;
    rdfs:label "Product specification" ;
    rdfs:comment """
        A reusable definition of the intended product construction
        or customer-specific product configuration.
    """ .

wa:SAPMaterialCode
    a owl:Class ;
    rdfs:label "SAP material code" ;
    rdfs:comment """
        A product or material identifier assigned by an ERP system (SAP for Bekaert).
    """ .

wa:ProductionBatch
    a owl:Class ;
    rdfs:label "Production batch" ;
    rdfs:comment """
        A quantity managed as one production group at a particular
        stage of manufacturing.
    """ .

wa:Spool
    a owl:Class ;
    rdfs:label "Spool" ;
    rdfs:comment """
        A traceable quantity of material wound onto a spool and
        identified at a production stage.
    """ .

wa:ManufacturingProcess
    a owl:Class ;
    rdfs:label "Manufacturing process" ;
    rdfs:comment """
        A reusable type of manufacturing transformation, such as
        wire drawing, patenting, coating or rolling.
    """ .

wa:ProcessExecution
    a owl:Class ;
    rdfs:label "Process execution" ;
    rdfs:comment """
        One actual occurrence of a manufacturing process with
        identifiable inputs, outputs, equipment and time interval.
    """ .

wa:Equipment
    a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment """
        A physical production resource used for a process execution.
    """ .

wa:ProductionSite
    a owl:Class ;
    rdfs:label "Production site" ;
    rdfs:comment """
        A plant or production location at which manufacturing occurs.
    """ .

#################################################################
# Object properties
#################################################################

wa:identifiesSpecification
    a owl:ObjectProperty ;
    rdfs:label "identifies specification" ;
    rdfs:domain wa:ERPProductCode ;
    rdfs:range wa:ProductSpecification .

wa:classifiedBy
    a owl:ObjectProperty ;
    rdfs:label "classified by" ;
    rdfs:domain wa:ProductionBatch ;
    rdfs:range wa:ProductSpecification .

wa:partOfBatch
    a owl:ObjectProperty ;
    rdfs:label "part of batch" ;
    rdfs:domain wa:Spool ;
    rdfs:range wa:ProductionBatch .

wa:consumedBy
    a owl:ObjectProperty ;
    rdfs:label "consumed by" ;
    rdfs:domain wa:Spool ;
    rdfs:range wa:ProcessExecution .

wa:producesSpool
    a owl:ObjectProperty ;
    rdfs:label "produces spool" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range wa:Spool .

wa:realizesProcess
    a owl:ObjectProperty ;
    rdfs:label "realizes process" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range wa:ManufacturingProcess .

wa:performedOn
    a owl:ObjectProperty ;
    rdfs:label "performed on" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range wa:Equipment .

wa:occurredAt
    a owl:ObjectProperty ;
    rdfs:label "occurred at" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range wa:ProductionSite .

#################################################################
# Datatype properties
#################################################################

wa:erpCode
    a owl:DatatypeProperty ;
    rdfs:label "ERP code" ;
    rdfs:domain wa:ERPProductCode ;
    rdfs:range xsd:string .

wa:batchIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "batch identifier" ;
    rdfs:domain wa:ProductionBatch ;
    rdfs:range xsd:string .

wa:spoolIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "spool identifier" ;
    rdfs:domain wa:Spool ;
    rdfs:range xsd:string .

wa:executionIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "execution identifier" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range xsd:string .

wa:startTime
    a owl:DatatypeProperty ;
    rdfs:label "start time" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range xsd:dateTime .

wa:endTime
    a owl:DatatypeProperty ;
    rdfs:label "end time" ;
    rdfs:domain wa:ProcessExecution ;
    rdfs:range xsd:dateTime .

wa:name
    a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .